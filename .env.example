# Copy to the host environment. Do not commit real values.
# Only VITE_ variables are visible in the browser. Everything else stays on the server.

# Postgres connection for a deployed database. Leave unset locally;
# the app then uses an in-memory PGLite database and applies migrations itself.
# DATABASE_URL=postgres://user:password@host:5432/choguild

# Required on every deployed build. At least 32 characters (openssl rand -hex 32).
# Do not derive this from the database URL.
# CHOG_SESSION_SECRET=

# Optional override for the public Monad RPC. Official defaults are used when unset.
# VITE_MONAD_RPC_URL=https://rpc1.monad.xyz

# If you set a custom RPC, add its origin to connect-src in vercel.json (the CSP is enforced).

# Local/CI only: set to 1 to let `npm run db:migrate` run outside Vercel.
# On Vercel, migrations run only when VERCEL_ENV=production.
# CHOG_RUN_MIGRATIONS=1
