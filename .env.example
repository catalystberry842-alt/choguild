# Copy to the host environment. Do not commit real values.
# Only VITE_ variables are visible in the browser. Everything else stays on the server.

# Postgres connection for a deployed database. Leave unset in the workspace preview;
# the app then uses its local PGLite database and applies migrations itself.
# DATABASE_URL=postgres://user:password@host:5432/choguild

# Required when DATABASE_URL is set. At least 32 characters.
# Do not derive this from the database URL.
# CHOG_SESSION_SECRET=

# Optional override for the public Monad RPC. Official defaults are used when unset.
# VITE_MONAD_RPC_URL=https://rpc.monad.xyz

# Shipped default is sign-in disabled for the workspace auth gate.
# VITE_AUTH_ENABLED=false
